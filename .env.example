# News provider — NEWS_PROVIDER selects the implementation in app/services/news/
NEWS_PROVIDER=gnews
GNEWS_API_KEY=your-gnews-api-key
GNEWS_BASE_URL=https://gnews.io/api/v4/search

# AI provider — AI_PROVIDER selects the implementation in app/services/analysis/
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Database — hostname "db" matches the Compose service name
DATABASE_URL=postgresql+psycopg://newslens:newslens@db:5432/newslens
